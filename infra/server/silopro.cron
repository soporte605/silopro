# /etc/cron.d/silopro — respaldo diario (local y R2) y vigilante cada 5 minutos.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 3 * * * root /opt/silopro/current/infra/server/backup.sh >> /var/log/silopro-backup.log 2>&1
*/5 * * * * root /opt/silopro/current/infra/server/watchdog.sh >> /var/log/silopro-watchdog.log 2>&1
