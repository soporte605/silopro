# Copie este archivo a .env y ajuste los valores. Nunca suba .env al repositorio.
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:4200
# Rol SIN privilegios de superusuario ni BYPASSRLS (ver docs/DEPLOYMENT.md).
DATABASE_URL=postgres://silopro:silopro@localhost:5432/silopro
# Pruebas de integración: base desechable cuyo nombre contenga "test".
TEST_DATABASE_URL=postgres://silopro:silopro@localhost:5432/silopro_test
SESSION_TTL_DAYS=14
MIGRATE_ON_START=false

# Carpeta privada de fotografías (no la sirva un servidor web público).
UPLOADS_DIR=./data/uploads
# Origen de la web para los enlaces de invitación.
PUBLIC_WEB_URL=http://localhost:4200

# Correos con Resend (resend.com). Sin clave, se escriben en el registro.
# RESEND_API_KEY=
# El dominio del remitente debe estar verificado en Resend.
# MAIL_FROM=SiloPro <no-responder@silopro.elikarsystems.com>
# Solo desarrollo: guarda cada correo como JSON en esta carpeta.
# MAIL_OUTBOX_DIR=./data/correos
