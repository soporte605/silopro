{
  "name": "silopro",
  "version": "0.4.0-alpha.1",
  "private": true,
  "description": "SiloPro — sistema universal de inventario y almacenamiento inteligente. Producto de ElikarSystems.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" --if-present run build",
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" run build",
    "dev:api": "pnpm --filter @silopro/api dev",
    "dev:web": "pnpm --filter @silopro/web start",
    "typecheck": "pnpm build:packages && pnpm -r --if-present run typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose -f infra/docker/compose.yaml up -d postgres",
    "db:down": "docker compose -f infra/docker/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
